<script>
let cur=1; const done=new Set();
function goTo(n){document.getElementById('s'+cur).classList.remove('active');document.getElementById('s'+n).classList.add('active');cur=n;}
function mk(n){if(done.has(n))return;done.add(n);const el=document.getElementById('tn'+n);if(el){el.classList.add('done');el.textContent='✓';}}
function chQ(b,d){const n=b.parentElement.querySelector('.qnum');let q=parseInt(n.textContent)+d;if(q<1)q=1;if(q>9)q=9;n.textContent=q;}
function rmI(b){const i=b.closest('.item');i.style.transition='opacity .2s,transform .2s';i.style.opacity='0';i.style.transform='translateX(-14px)';setTimeout(()=>i.remove(),200);}
function showVc(){document.getElementById('vcBox').style.display='block';document.getElementById('vcLink').style.display='none';}
function applyVc(){const v=document.getElementById('vcInput').value.toUpperCase();if(v.includes('CRAFT')){document.getElementById('discRow').style.display='flex';document.getElementById('totalAmt').textContent='£31.41';document.getElementById('vcInput').value='CRAFT10 — Applied ✓';document.getElementById('vcInput').disabled=true;document.getElementById('vcInput').style.borderColor='#007A20';mk(3);}}
function pcLookup(){const v=document.getElementById('pcIn').value;if(v.length>=3){document.getElementById('fn').value='Jane';document.getElementById('ln').value='Smith';document.getElementById('a1').value='12 Craft Lane';document.getElementById('ct').value='Norwich';document.getElementById('pc').value=v.toUpperCase();document.getElementById('afMsg').style.display='block';}}
function selD(el){document.querySelectorAll('.del-opt').forEach(o=>o.classList.remove('sel'));el.classList.add('sel');}
function selT(el){document.querySelectorAll('.tab').forEach(t=>t.classList.remove('act'));el.classList.add('act');const tx=el.textContent.trim();document.getElementById('cF').style.display=tx==='Card'?'block':'none';document.getElementById('pF').style.display=tx==='PayPal'?'block':'none';document.getElementById('aF').style.display=tx==='Apple Pay'?'block':'none';}
function fC(i){let v=i.value.replace(/\D/g,'').substring(0,16);i.value=v.replace(/(.{4})/g,'$1 ').trim();}
function fE(i){let v=i.value.replace(/\D/g,'');if(v.length>=2)v=v.substring(0,2)+' / '+v.substring(2,4);i.value=v;}
function placeOrder(){const b=event.target;b.textContent='Processing…';b.style.opacity='.7';setTimeout(()=>{mk(1);goTo(4);},1200);}
function showFb(){document.getElementById('phone').style.display='none';document.getElementById('taskPanel').style.display='none';document.getElementById('fbForm').style.display='block';window.scrollTo({top:0,behavior:'smooth'});}
function rt(id,n){document.querySelectorAll('#'+id+' .star').forEach((s,i)=>s.classList.toggle('lit',i<n));}
function subFb(){document.getElementById('fbForm').style.display='none';document.getElementById('ty').style.display='block';window.scrollTo({top:0,behavior:'smooth'});}
</script>
